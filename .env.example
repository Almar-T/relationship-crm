# Copy to `.env` (or `.env.local`) and fill in.
# These are PUBLIC values — they are bundled into the client. The VAPID *private*
# key never lives here; it is a Cloudflare Worker secret.

# The base64url-encoded VAPID public key. Run `npm run generate:vapid` to create one.
VITE_VAPID_PUBLIC_KEY=

# The deployed Cloudflare Worker URL that stores push subscriptions.
# Example: https://reconnect-push.<your-subdomain>.workers.dev
VITE_PUSH_API_URL=

# Optional: override the GitHub Pages base path (defaults to /relationship-crm/).
# Set to "/" for custom domains or local-only use.
# VITE_BASE=/relationship-crm/
